# ==============================================================================
# KONFIGURASI KREDENSIAL & ENVIRONMENT PENS KP BOT
# ==============================================================================

# Kredensial PENS CAS (Wajib)
# Masukkan NetID / email student PENS dan kata sandi akun login PENS Anda
PENS_NETID=namauser@student.pens.ac.id
PENS_PASSWORD=katasandimahasiswa

# Konfigurasi Mahasiswa & Pendaftaran KP (Opsional jika AUTO_DISCOVER=true)
# Jika dikosongkan, script akan otomatis membaca nilai ini dari portal PENS MIS saat setup/run
PENS_NRP=
PENS_MAHASISWA_ID=
PENS_KP_DAFTAR_ID=
PENS_TAHUN=
PENS_SEMESTER=

# Mode Pengisian Logbook (Pilihan: 'dual' atau 'single')
# - 'dual'   : 2 kali sehari (Pagi 07:00-12:00 dijalankan jam 12:00, Sore 13:00-16:00 dijalankan jam 16:00)
# - 'single' : 1 kali sehari (08:00-16:00 atau jam kerja yang dikonfigurasi di config.yaml)
SUBMISSION_MODE=dual

# Bidang Kegiatan Kerja Praktek (Pilihan: software, network, iot, sysadmin, data, general)
ACTIVITY_DOMAIN=software

# Tanggal Awal Kerja Praktek (Format: YYYY-MM-DD)
# Digunakan untuk menghitung nomor minggu KP secara akurat jika diperlukan
KP_START_DATE=2026-08-31

# Pengaturan Proxy Jaringan (Opsional)
# Kosongkan jika menjalankan dari Indonesia atau jaringan tanpa blokir geofencing
# Contoh jika di luar negeri: socks5h://127.0.0.1:9050 atau http://user:pass@host:port
PROXY_URL=

# Notifikasi Telegram (Opsional)
# Dapatkan token dari @BotFather dan ID dari @userinfobot jika ingin laporan terkirim ke Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Notifikasi Discord (Opsional)
# Masukkan Webhook URL channel Discord jika ingin laporan terkirim ke server Discord
DISCORD_WEBHOOK_URL=
